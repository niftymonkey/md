# WorkOS AuthKit (UI auth) — get from https://dashboard.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# For local dev: http://localhost:3000/callback
# For prod: https://md.niftymonkey.dev/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
# Random 32+ char string for cookie encryption. Generate: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Comma-separated list of emails allowed to sign in (case-insensitive)
ALLOWED_EMAILS=

# Vercel Postgres connection string (Neon-backed)
POSTGRES_URL=

# Bearer auth uses personal API tokens generated at /settings (after sign-in).
# No env-var-based shared secret is required for the API to function.
# For curl/agents, paste the token shown at creation into your shell:
#   export MD_API_KEY=mdk_...
